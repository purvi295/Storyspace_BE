    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const payload = body.data || body;",
                  "if (payload.token) pm.collectionVariables.set('token', payload.token);",
                  "if (payload.user && payload.user.username) pm.collectionVariables.set('username', payload.user.username);",
                  "if (payload.user && payload.user.user_uuid) pm.collectionVariables.set('userUuid', payload.user.user_uuid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password123!\",\n  \"username\": \"postman_user\",\n  \"fullName\": \"Postman User\",\n  \"full_name\": \"Postman User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Required:\n- email: valid email, max 100 characters\n- password: 8 to 128 characters\n- username: 3 to 50 characters. Letters, numbers, underscore, hyphen, and period.\n- full name: send fullName or full_name (2 to 150 characters). Both are accepted; one is enough."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const payload = body.data || body;",
                  "if (payload.token) pm.collectionVariables.set('token', payload.token);",
                  "if (payload.user && payload.user.username) pm.collectionVariables.set('username', payload.user.username);",
                  "if (payload.user && payload.user.user_uuid) pm.collectionVariables.set('userUuid', payload.user.user_uuid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Required:\n- email: valid email, max 100 characters\n- password: 1 to 128 characters"
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const payload = body.data || body;",
                  "if (payload.token) pm.collectionVariables.set('adminToken', payload.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Same login payload. Saves the token to adminToken so user requests keep using token.\n\nReplace email and password with the seeded admin account (ADMIN_EMAIL and ADMIN_PASSWORD)."
