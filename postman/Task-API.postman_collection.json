    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const payload = body.data || body;",
                  "if (payload.token) pm.collectionVariables.set('token', payload.token);",
                  "if (payload.user && payload.user.username) pm.collectionVariables.set('username', payload.user.username);",
                  "if (payload.user && payload.user.user_uuid) pm.collectionVariables.set('userUuid', payload.user.user_uuid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password123!\",\n  \"username\": \"postman_user\",\n  \"fullName\": \"Postman User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "All fields are required.\n\n- email: valid email, max 100 characters\n- password: 8 to 128 characters\n- username: letters and numbers only, 3 to 50 characters\n- fullName: 2 to 150 characters"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const payload = body.data || body;",
                  "if (payload.token) pm.collectionVariables.set('token', payload.token);",
                  "if (payload.user && payload.user.username) pm.collectionVariables.set('username', payload.user.username);",
                  "if (payload.user && payload.user.user_uuid) pm.collectionVariables.set('userUuid', payload.user.user_uuid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "All fields are required.\n\n- email: valid email, max 100 characters\n- password: required"
          }
        },
