            {
              "name": "Create Story",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const body = pm.response.json();",
                      "const story = body.data || {};",
                      "if (story.slug) {",
                      "  pm.collectionVariables.set('storySlug', story.slug);",
                      "  pm.collectionVariables.set('storyIdentifier', story.slug);",
                      "}",
                      "if (story.story_uuid) pm.collectionVariables.set('storyUuid', story.story_uuid);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{token}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "title",
                      "value": "{{storyTitle}}",
                      "type": "text",
                      "description": "Required. 3 to 255 characters. Driven by bulk_create_story.csv storyTitle column."
                    },
                    {
                      "key": "content",
                      "value": "{{storyContent}}",
                      "type": "text",
                      "description": "Required. At least 10 characters. Driven by bulk_create_story.csv storyContent column."
                    },
                    {
                      "key": "slug",
                      "value": "{{storySlug}}",
                      "type": "text",
                      "description": "Optional. 3 to 300 characters. Driven by bulk_create_story.csv storySlug column."
                    },
                    {
                      "key": "summary",
                      "value": "{{storySummary}}",
                      "type": "text",
                      "description": "Optional. 3 to 500 characters. Driven by bulk_create_story.csv storySummary column."
                    },
                    {
                      "key": "coverImageUrl",
                      "value": "",
                      "type": "text",
                      "description": "Optional URL. Leave empty when uploading a file."
                    },
                    {
                      "key": "status",
                      "value": "{{storyStatus}}",
