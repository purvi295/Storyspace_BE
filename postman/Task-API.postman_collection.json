        {
          "name": "Create Story",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const story = body.data || {};",
                  "if (story.slug) {",
                  "  pm.collectionVariables.set('storySlug', story.slug);",
                  "  pm.collectionVariables.set('storyIdentifier', story.slug);",
                  "}",
                  "if (story.story_uuid) pm.collectionVariables.set('storyUuid', story.story_uuid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Story\",\n  \"content\": \"This is the full content of my story. It must be at least 100 characters long to pass validation and give the story enough text to publish.\",\n  \"slug\": \"my-first-story\",\n  \"summary\": \"A brief summary of my first story\",\n  \"coverImageUrl\": \"https://example.com/covers/my-first-story.png\",\n  \"status\": \"published\",\n  \"visibility\": \"public\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/stories/create",
            "description": "Required:\n- title: at least 10 characters, must be unique\n- content: at least 100 characters\n\nOptional:\n- slug: 3 to 300 characters. Generated from the title when omitted.\n- summary: 10 to 500 characters\n- coverImageUrl: valid URL\n- status: draft, submitted, approved, rejected, or published. Defaults to draft.\n- visibility: public or followers_only. Defaults to followers_only."
          }
        },
